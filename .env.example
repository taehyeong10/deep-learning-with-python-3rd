# 노트북 실행 환경 설정.
# 이 파일을 .env 로 복사한 뒤 환경에 맞게 고쳐서 사용합니다 (chapter02_guide.md 참고).
# 노트북의 설정 셀이 .env 를 읽어 환경 변수로 등록합니다.

# 케라스 백엔드: tensorflow / jax / torch
# 2장은 tf.GradientTape 를 쓰는 셀이 있어 tensorflow 가 필요합니다.
KERAS_BACKEND=tensorflow

# 데이터셋 파일을 모아 둔 디렉터리.
# 노트북은 여기서 파일을 직접 읽습니다. 예) mnist.npz -> $DATASET_DIR/mnist.npz
# 외부 접속이 막힌 환경에서는 파일을 미리 넣어 둡니다.
DATASET_DIR=/path/to/datasets
